#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake

# dh_auto_configure passes CMAKE_INSTALL_PREFIX=/usr, the multiarch
# CMAKE_INSTALL_LIBDIR, CMAKE_BUILD_TYPE=None and the build flags
override_dh_auto_configure:
	dh_auto_configure -- \
	  -DGLGRIB_PYTHON_INSTALL_DIR=/usr/lib/python3/dist-packages \
	  -DGLGRIB_WITH_TOOLS=OFF

# The tests render images with OpenGL and need a GPU
override_dh_auto_test:
